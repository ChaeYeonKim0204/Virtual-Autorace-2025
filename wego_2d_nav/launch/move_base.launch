<launch>
    <node pkg="move_base" type="move_base" name="move_base" output="screen"/>
        <!--costmap 관련-->
        <rosparm file="$(find wego_2d_nav)/parms/costmap_comman_params.yaml" command="load" ns="global_costmap"/>
        <rosparm file="$(find wego_2d_nav)/parms/costmap_comman_params.yaml" command="load" ns="local_costmap"/>
        <rosparm file="$(find wego_2d_nav)/parms/global_costmap_params.yaml" command="load" ns="local_costmap"/> 
        <rosparm file="$(find wego_2d_nav)/parms/local_costmap_params.yaml" command="load" ns="local_costmap"/>
        <!--global planner & local 관련--> 
        <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
        <param name="use_dijkstra" value="true"/> 
        <param name="planning_frequency" value="5.0"/> 
        <param name="planner_patience" value="5.0"/> 
        <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/> 
        <rosparam file="$(find wego_2d_nav)/params/teb_local_planner_params.yaml" command="load"/> 
        <param name="controller_frequency" value="10.0"/> <param name="controller_patience" value="7.0"/> 
        
        <param name="clearing_rotation_allowed" value="false"/> 
        <remap from="odom" to="/odometry/filtered"/> 
    </node>
</launch>